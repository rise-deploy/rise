---
const docsBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
	['Rise App Builder SKILL.md', `${docsBase}/skills/rise-app-builder/SKILL.md`],
	['CLI cheatsheet', `${docsBase}/skills/rise-app-builder/reference/cli-cheatsheet.md`],
	['rise.toml reference', `${docsBase}/skills/rise-app-builder/reference/rise-toml-reference.md`],
];
---

<ul>
	{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
</ul>
