  "query": "\n        SELECT\n            id, name,\n            status as \"status: ProjectStatus\",\n            access_class,\n            owner_user_id, owner_team_id,\n            finalizers, source_url,\n            template_id, template_image,\n            created_at, updated_at\n        FROM projects\n        WHERE status NOT IN ('Deleting', 'Terminated')\n        ORDER BY created_at DESC\n        ",
