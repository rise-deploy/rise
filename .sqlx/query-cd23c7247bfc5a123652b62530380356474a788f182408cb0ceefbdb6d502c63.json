  "query": "\n        SELECT t.id, t.name, t.idp_managed, t.created_at, t.updated_at\n        FROM teams t\n        INNER JOIN team_members tm ON t.id = tm.team_id\n        WHERE tm.user_id = $1\n        ORDER BY t.created_at DESC\n        ",
