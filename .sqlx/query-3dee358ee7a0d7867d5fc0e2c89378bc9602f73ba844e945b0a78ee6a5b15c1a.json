{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT DISTINCT\n            p.id, p.name,\n            p.status as \"status: ProjectStatus\",\n            p.access_class,\n            p.owner_user_id, p.owner_team_id,\n            p.finalizers, p.source_url,\n            p.created_at, p.updated_at\n        FROM projects p\n        WHERE\n            p.owner_team_id = $1\n            OR EXISTS(\n                SELECT 1 FROM project_app_teams pat\n                WHERE pat.project_id = p.id\n                AND pat.team_id = $1\n            )\n        ORDER BY p.created_at DESC\n        ",
